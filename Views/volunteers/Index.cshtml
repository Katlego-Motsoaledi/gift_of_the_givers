@model Volunteer
@{
    ViewData["Title"] = "Volunteer";
}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="gotg-hero text-white rounded p-4 p-md-5">
                <div class="text-uppercase small gotg-gold mb-1">Join the response</div>
                <h1 class="h3">Sign Up To Volunteer</h1>
                @if (ViewBag.Success != null)
                {
                    <div class="alert alert-success mt-3">@ViewBag.Success</div>
                }
                <form asp-action="Register" method="post" class="mt-3">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="FirstName" class="form-label">First name</label>
                            <input asp-for="FirstName" class="form-control" placeholder="Naledi"><span asp-validation-for="FirstName" class="text-warning small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="LastName" class="form-label">Last name</label>
                            <input asp-for="LastName" class="form-control" placeholder="Khumalo"><span asp-validation-for="LastName" class="text-warning small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label">Email</label>
                            <input asp-for="Email" class="form-control" placeholder="you@example.org"><span asp-validation-for="Email" class="text-warning small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Phone" class="form-label">Phone</label>
                            <input asp-for="Phone" class="form-control" placeholder="082 555 0134"><span asp-validation-for="Phone" class="text-warning small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="SkillSet" class="form-label">Skills you can offer</label>
                            <input asp-for="SkillSet" class="form-control" placeholder="e.g. Logistics, First Aid, Driving"><span asp-validation-for="SkillSet" class="text-warning small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Availability" class="form-label">Availability</label>
                            <select asp-for="Availability" class="form-select">
                                <option value="">Select…</option>
                                <option>Weekends</option>
                                <option>Weekdays</option>
                                <option>On-call</option>
                            </select><span asp-validation-for="Availability" class="text-warning small"></span>
                        </div>
                    </div>
                    <button type="submit" class="btn btn-gotg mt-4">Register as a volunteer</button>
                </form>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}